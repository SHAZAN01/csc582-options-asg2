classDiagram
    note "Walkthrough rehearsal only - incomplete domain model."

    class Asset {
        <<interface>>
        +value() Money
    }

    class Stock {
        +Money spot
        +value() Money
    }

    class Option {
        <<abstract>>
        +Money strike
        +value() Money
    }

    class Position {
        +Integer quantity
        +value() Money
    }

    class Account {
        +value() Money
    }

    Asset <|.. Stock
    Asset <|.. Option
    Account "1" *-- "0..*" Position : owns
    Position "0..*" --> "1" Asset : holds
